{
  "name": "@atc-web/shortlink",
  "version": "1.0.0",
  "private": true,
  "description": "Short links over HTTP: redirects with expiry and click limits, click statistics, QR codes as SVG or PNG",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alitalipcalikoglu/shortlink.git"
  },
  "type": "module",
  "main": "src/index.js",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "start": "node --disable-warning=ExperimentalWarning src/index.js",
    "dev": "node --disable-warning=ExperimentalWarning --watch --env-file=.env src/index.js",
    "test": "node --disable-warning=ExperimentalWarning --test \"test/**/*.test.js\"",
    "typecheck": "tsc -p jsconfig.json"
  },
  "dependencies": {
    "@atc-web/service-core": "github:alitalipcalikoglu/service-core#v1.2.1",
    "@fastify/rate-limit": "11.2.0",
    "fastify": "5.12.4"
  },
  "devDependencies": {
    "@types/node": "22.20.3",
    "typescript": "7.0.2"
  }
}
